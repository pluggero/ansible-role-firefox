{
  "extends": ["config:best-practices", ":disableRateLimiting"],
  "automerge": false,
  "automergeType": "pr",
  "packageRules": [
    {
      "matchManagers": ["github-actions", "pip_requirements"],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["python/cpython"],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "7 days"
    },
    {
      "matchDatasources": ["github-runners"],
      "automerge": false
    },
    {
      "matchManagers": ["custom.regex"],
      "automerge": false
    }
  ],
  "enabledManagers": ["github-actions", "pip_requirements", "custom.regex"],
  "assignees": ["pluggero"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "automerge": false,
    "labels": ["security"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^defaults/main\\.yml$/",
        "/^meta/argument_specs\\.yml$/"
      ],
      "matchStrings": [
        "firefox_version:\\s+\"(?<currentValue>[\\d\\.]+)\"",
        "firefox_version:\\s*\\n\\s*type: str\\s*\\n\\s*default: \"(?<currentValue>[\\d\\.]+)\""
      ],
      "datasourceTemplate": "custom.firefox",
      "depNameTemplate": "firefox",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "/pub/firefox/releases/(?<version>[\\d.]+?)/"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "\\.github/workflows/.+\\.ya?ml$"
      ],
      "matchStrings": [
        "python-version:\\s+[\"'](?<currentValue>\\d+\\.\\d+)[\"']"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "python/cpython",
      "versioningTemplate": "semver"
    }
  ],
  "customDatasources": {
    "firefox": {
      "defaultRegistryUrlTemplate": "https://ftp.mozilla.org/pub/firefox/releases/",
      "format": "html"
    }
  }
}
